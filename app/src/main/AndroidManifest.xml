<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 알림 권한 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager용 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Health Connect — 물 마시기는 저장만 하므로 쓰기 권한만 선언(읽기는 쓰지 않음) -->
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />

    <!-- Firebase Analytics가 자동으로 추가하는 광고 식별자 권한 제거 — 앱은 광고/개인화 기능이 없고
         "광고 식별자 사용 안 함" 방침을 유지하므로 명시적으로 opt-out -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />

    <!-- Android 11+(API 30+) 패키지 가시성 제한 대응 — 이게 없으면 AppInfoScreen의
         intent.resolveActivity(packageManager)가 메일 앱이 설치돼 있어도 항상 null을 반환해,
         "의견 보내기"를 눌러도 아무 반응이 없는 상태가 됨(2026-07-07 사용자 제보로 발견) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".WateringApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Watering">

        <!-- 광고 식별자 수집 비활성화 (권한 제거와 이중 처리) -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Watering">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect 권한 설명(rationale) 화면 요청 처리 — Health Connect 컨트롤러 앱은
                 이 정확한 action+category 조합(VIEW_PERMISSION_USAGE / HEALTH_PERMISSIONS)으로만
                 rationale 지원 여부를 판단한다(androidx 문서의 SHOW_PERMISSIONS_RATIONALE는 이
                 시스템 버전에 해당하지 않음 — HealthPermissionReader.getRationaleIntent 디컴파일로 확인) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!-- 원형 위젯 -->
        <receiver
            android:name=".widget.CircularWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/circular_widget_info" />
        </receiver>

        <!-- 직사각형 위젯 -->
        <receiver
            android:name=".widget.RectangularWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rectangular_widget_info" />
        </receiver>

        <!-- 좁은 위젯 -->
        <receiver
            android:name=".widget.NarrowWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/narrow_widget_info" />
        </receiver>

        <!-- HiltWorkerFactory 사용을 위해 WorkManager 기본 자동 초기화 비활성화 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- CSV 내보내기 공유용 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
